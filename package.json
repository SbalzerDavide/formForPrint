{
  "name": "form_for_print",
  "productName": "Form for Print",
  "description": "Compilazione e stampa di referti ostetrico-ginecologici",
  "author": "Davide Sbalzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on tcp:localhost:5173 && electron . --dev-server=http://localhost:5173\"",
    "electron:start": "vite build --outDir dist-app --emptyOutDir && electron .",
    "electron:build": "vite build --outDir dist-app --emptyOutDir && electron-builder",
    "electron:build:mac": "vite build --outDir dist-app --emptyOutDir && electron-builder --mac",
    "electron:build:win": "vite build --outDir dist-app --emptyOutDir && electron-builder --win"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@prettier/plugin-pug": "^3.4.0",
    "@primevue/themes": "^4.3.9",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "normal-distribution": "^1.1.1",
    "prettier": "^3.5.3",
    "primevue": "^4.3.9",
    "sass": "^1.107.1",
    "sass-embedded": "^1.93.2",
    "vite": "^4.0.0",
    "vue": "^3.2.45",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "eu.formforprint.app",
    "productName": "Form for Print",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-app/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
